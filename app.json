{
  "name": "talha-md",
  "description": "TALHA MD — Feature-rich multi-device WhatsApp bot with 500+ commands, autonomous AI agent, anti-delete, media downloaders, and sub-bot pairing.",
  "keywords": ["talha-md", "whatsapp", "baileys", "bot", "multi-device", "ai", "chatbot", "whatsapp-bot", "nodejs"],
  "logo": "https://files.catbox.moe/ie7zbn.jpg",
  "website": "https://github.com/talhahafiz236/talha-md",
  "success_url": "/",
  "stack": "heroku-24",
  "env": {
    "SESSION_ID": {
      "description": "Your WhatsApp permanent SESSION_ID (TALHA-MD~...).",
      "required": true,
      "value": ""
    },
    "OWNER_NUMBER": {
      "description": "Owner WhatsApp number with country code (e.g. 923426767199).",
      "required": true,
      "value": "923426767199"
    },
    "PREFIX": {
      "description": "Command prefix. Single: '.' | Multiple: '.,!,/,?' | Any symbol: 'any' | No prefix: 'none'.",
      "required": false,
      "value": "."
    },
    "MODE": {
      "description": "Bot mode: public, private, group, inbox, both.",
      "required": false,
      "value": "both"
    },
    "BOT_NAME": {
      "description": "Bot display name shown in menus and greetings.",
      "required": false,
      "value": "TALHA MD"
    },
    "OWNER_NAME": {
      "description": "Bot owner's display name.",
      "required": false,
      "value": "Talha Sheikh"
    },
    "THEME": {
      "description": "Bot theme (default: talha).",
      "required": false,
      "value": "talha"
    },
    "ALIVE_IMG": {
      "description": "Image URL shown with the menu command.",
      "required": false,
      "value": "https://files.catbox.moe/cpm6od.jpg"
    },
    "GEMINI_API_KEY": {
      "description": "Optional Google Gemini API key for AI responses.",
      "required": false,
      "value": ""
    },
    "DATABASE_URL": {
      "description": "Optional Postgres connection URL (set securely in host secrets).",
      "required": false,
      "value": ""
    },
    "ANTIDELETE_GROUP": {
      "description": "Recover deleted messages in groups (true/false).",
      "required": false,
      "value": "true"
    },
    "ANTIDELETE_PRIVATE": {
      "description": "Recover deleted messages in private chats (true/false).",
      "required": false,
      "value": "true"
    },
    "AUTO_STATUS_SEEN": {
      "description": "Auto-view all WhatsApp status updates (true/false).",
      "required": false,
      "value": "false"
    },
    "AUTO_STATUS_REACT": {
      "description": "Auto-react to status updates with emoji (true/false).",
      "required": false,
      "value": "false"
    },
    "ALWAYS_ONLINE": {
      "description": "Keep bot always shown as online (true/false).",
      "required": false,
      "value": "true"
    },
    "ANTIVV": {
      "description": "Auto-recover view-once messages (true/false).",
      "required": false,
      "value": "true"
    },
    "ANTILINK": {
      "description": "Auto-remove links in groups (true/false).",
      "required": false,
      "value": "false"
    },
    "ANTICALL": {
      "description": "Auto-reject incoming calls (true/false).",
      "required": false,
      "value": "false"
    },
    "TIMEZONE": {
      "description": "Timezone for date/time features (default: Asia/Karachi).",
      "required": false,
      "value": "Asia/Karachi"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ]
}
